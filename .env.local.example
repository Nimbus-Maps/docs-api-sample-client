# =============================================================================
# Nimbus Document Purchase API - Sample Client Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to version control

# -----------------------------------------------------------------------------
# Authentication Mode
# -----------------------------------------------------------------------------
# Use "obo" for delegated user authentication with PKCE.
# Use "client_credentials" for server-to-server authentication with an Entra app secret.
DOCUMENT_API_AUTH_MODE=obo

# -----------------------------------------------------------------------------
# Azure AD OAuth 2.0 Configuration - OBO mode
# -----------------------------------------------------------------------------
# These values must be provided by Nimbus. Your Azure AD app registration
# is created in the Nimbus tenant (not your own tenant).

# Nimbus Azure AD Tenant ID (fixed value)
AZURE_TENANT_ID=d2a91423-0dc1-4853-8515-7b7b7d262791

# Your Client ID (provided by Nimbus after app registration)
# Your app is registered as a PUBLIC CLIENT (PKCE flow, no client secret)
AZURE_CLIENT_ID=your-client-id-here

# OAuth Redirect URI - Must match what's registered in Azure AD
# For local development:
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# -----------------------------------------------------------------------------
# Entra Client Credentials Configuration - client_credentials mode
# -----------------------------------------------------------------------------
# Uncomment and fill these in when DOCUMENT_API_AUTH_MODE=client_credentials.
# ENTRA_CLIENT_ID=your-entra-client-id-here
# ENTRA_CLIENT_SECRET=your-entra-client-secret-here

# Pre-production S2S scope:
# DOCUMENT_API_SCOPE=api://f995e7f1-7a92-4c17-82a7-3187c5b158bf/.default

# Production S2S scope:
# DOCUMENT_API_SCOPE=api://d5ddd66b-0c00-4c46-bb81-672727b71aa5/.default

# -----------------------------------------------------------------------------
# Nimbus Document API Configuration
# -----------------------------------------------------------------------------
# Document API URL - choose one environment:

# Pre-production (for testing)
DOCUMENT_API_URL=https://api-preprod.nimbusmaps.xyz/docs/v1
DOCUMENT_API_APP_ID=aaa610c3-9375-4a50-8383-26a0b59f7ea2

# Production (uncomment to use production)
# DOCUMENT_API_URL=https://api.nimbusmaps.co.uk/docs/v1
# DOCUMENT_API_APP_ID=d5ddd66b-0c00-4c46-bb81-672727b71aa5

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Base URL for this application (used for OAuth redirects and webhooks)
# For local development:
NEXTAUTH_URL=http://localhost:3000

# For production/deployment, use your actual domain:
# NEXTAUTH_URL=https://your-domain.com

# For webhook testing with ngrok (update after starting ngrok):
# NEXTAUTH_URL=https://your-ngrok-subdomain.ngrok.io

# Session Secret - Generate a random 32+ character string
# You can generate one with: openssl rand -base64 32
SESSION_SECRET=your-random-session-secret-at-least-32-characters-long

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------

# Node environment
NODE_ENV=development

# Log level (info, debug, warn, error)
LOG_LEVEL=info

# HTTP Request/Response Logging
# WARNING: This logs full HTTP requests and responses including Authorization headers
# Only enable in development for debugging - NEVER in production
ENABLE_HTTP_LOGGING=true

# HTTP log level (separate from general LOG_LEVEL)
# Controls verbosity of HTTP request/response logs
HTTP_LOG_LEVEL=debug
