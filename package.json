{
  "name": "nimbus-docs-sample-client",
  "version": "1.0.0",
  "description": "Sample Next.js web application demonstrating integration with Nimbus Document Purchase API",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "quality": "npm run type-check && npm run lint && npm run format:check",
